[Unit]
Description=Wall-in-One wallpaper rotation service
Documentation=https://github.com/Go08er/wall-in-one
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Compilation is fail-closed and preserves the previous resolved document.
# Let Rust decide whether that last-known-good document is still usable.
ExecStartPre=-wall-in-one --write-config
ExecStart=wall-in-one-service --wait-for-config
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
