# Maintainer: goober <149829787+Go08er@users.noreply.github.com>

pkgname=wall-in-one
pkgver=0.4.0
pkgrel=1
pkgdesc='Wallpaper manager for Wayland with Noctalia palette sync'
arch=(x86_64 aarch64)
url='https://github.com/Go08er/wall-in-one'
license=(MIT)
# Noctalia 5 is in [extra]. The app is useless without it (it applies the
# wallpaper and the palette through Noctalia), so it is a hard dependency.
depends=(
  'ffmpeg'
  'glib2'
  'graphene'
  'gtk4'
  'libadwaita'
  'noctalia>=5'
  'pango'
  'python>=3.14'
  'python-cairo'
  'python-gobject'
)
makedepends=(
  'cargo'
  'python-build'
  'python-installer'
  'python-setuptools'
)
checkdepends=(
  'dbus'
  'python-pytest'
)
# Both renderers are external and managed by the user; the app finds them on
# PATH (/usr/bin included) and controls them, so neither is a dependency, and
# neither is in the official repos. The AUR's linux-wallpaperengine-git
# provides linux-wallpaperengine, so naming the plain package here is met by
# either of them.
optdepends=(
  'mpvpaper: video wallpapers (AUR)'
  'linux-wallpaperengine: Wallpaper Engine scenes (AUR: linux-wallpaperengine-git)'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# TODO(release): 'SKIP' only until v0.4.0 is tagged and GitHub serves its
# tarball. Right after tagging, run `updpkgsums` in this directory, regenerate
# .SRCINFO (`makepkg --printsrcinfo > .SRCINFO`) and commit both. A published
# package must never keep 'SKIP'.
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  # The Python half's install kind is a line of source, so it is set before
  # the wheel is built. The service's half comes from the environment in
  # build() and check(); tools/check-install-kind.sh, at the end of
  # package(), checks that the two agree. See docs/packaging.md.
  tools/set-install-kind.sh system
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --manifest-path service/Cargo.toml \
    --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  # Cargo tracks this through option_env!, so it must be the same in check().
  export WALL_IN_ONE_INSTALL_KIND=system
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --manifest-path service/Cargo.toml
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  # Not optional: without it `cargo test --release` rebuilds
  # target/release/wall-in-one-service as a `source` build in the same target
  # directory, and package() would install that one. The Python suite also
  # asserts that the module (set in prepare()) matches this variable.
  export WALL_IN_ONE_INSTALL_KIND=system
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The service's integration tests exec scripts they have just written; run
  # in parallel that races ("Text file busy"), so keep them serial.
  RUST_TEST_THREADS=1 cargo test --frozen --release --manifest-path service/Cargo.toml
  # The non-GUI suite only: no compositor in a build chroot, and no Noctalia
  # binary is driven. Neither renderer is needed: the tests stand in for them.
  # tests/conftest.py sandboxes HOME, XDG_* and the buses itself, and the
  # tests use no network; ffmpeg (a runtime dependency) is what the thumbnail
  # tests use, and dbus (a checkdepend) the service's integration tests.
  PYTHONPATH="$PWD/src" python -m pytest tests -q -p no:cacheprovider \
    -m 'not gui and not noctalia'
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm755 target/release/wall-in-one-service \
    "$pkgdir/usr/bin/wall-in-one-service"

  # Exec, TryExec and the units' ExecStart are bare command names, which
  # resolve to /usr/bin here, so the files go in as they are.
  local data=src/wall_in_one/data id=dev.goober.WallInOne
  install -Dm644 "$data/$id.desktop" \
    "$pkgdir/usr/share/applications/$id.desktop"
  install -Dm644 "$data/$id.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$id.svg"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" \
    "$data/systemd/wall-in-one.service" \
    "$data/systemd/wall-in-one-health-sync.service" \
    "$data/systemd/wall-in-one-health-sync.timer"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Last: both installed halves must say they are a `system` install, and the
  # same release. The Python half is run from $pkgdir's site-packages.
  local site
  site="$pkgdir$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
  PYTHONPATH="$site" tools/check-install-kind.sh system \
    "$pkgdir/usr/bin/wall-in-one" "$pkgdir/usr/bin/wall-in-one-service"
  # ... and the release is this package's pkgver. The check above only makes
  # the halves agree with each other; if the version was not bumped before
  # tagging, both would say the old one and ship under the new package name.
  local program shipped
  for program in wall-in-one wall-in-one-service; do
    shipped=$(PYTHONPATH="$site" "$pkgdir/usr/bin/$program" --version | sed -n 1p)
    if [[ $shipped != "$program $pkgver" ]]; then
      error "$program --version says '$shipped', expected '$program $pkgver'"
      return 1
    fi
  done
}
