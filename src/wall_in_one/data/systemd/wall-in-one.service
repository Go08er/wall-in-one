[Unit]
Description=Wall-in-One wallpaper rotation service
Documentation=https://github.com/Go08er/wall-in-one
PartOf=graphical-session.target
After=graphical-session.target
Wants=wall-in-one-health-sync.timer
Before=wall-in-one-health-sync.timer
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Compilation is fail-closed and preserves the previous resolved document.
# Let Rust decide whether that last-known-good document is still usable.
ExecStartPre=-wall-in-one --write-config
ExecStart=wall-in-one-service --wait-for-config
# A regular timer owns durable quarantine persistence. This final attempt is
# deliberately capped so a wedged authoring store cannot delay service stop.
ExecStop=-timeout --signal=TERM --kill-after=0.1s 2s wall-in-one --sync-runtime-health-on-stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
